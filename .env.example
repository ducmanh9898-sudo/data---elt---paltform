POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=environment_backend
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_SECURE=false
MINIO_BUCKET=environment-data

OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

AIR_QUALITY_PAST_DAYS=7
AIR_QUALITY_FORECAST_DAYS=0
AIR_QUALITY_TIMEOUT_SECONDS=30

WEATHER_PAST_DAYS=7
WEATHER_FORECAST_DAYS=7
WEATHER_TIMEOUT_SECONDS=60
WEATHER_REQUEST_DELAY_SECONDS=0.2

RAW_AIR_QUALITY_DIR=data/raw/air_quality
RAW_WEATHER_DIR=data/raw/weather
SPARK_BASE_IMAGE=apache/spark:4.1.3-scala2.13-java17-python3-r-ubuntu

HADOOP_AWS_VERSION=3.5.0
AWS_SDK_V2_BUNDLE_VERSION=2.35.4
ANALYTICS_ACCELERATOR_VERSION=1.3.1

SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=2G
ICEBERG_VERSION=1.11.0
POLARIS_VERSION=1.6.0
TRINO_VERSION=483
# Superset metadata database
SUPERSET_DB=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=change_me

# Superset application
SUPERSET_SECRET_KEY=change_me_to_a_long_random_value
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=Environment
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@example.local
SUPERSET_ADMIN_PASSWORD=change_me

# Native Streaming
KAFKA_IMAGE=apache/kafka:4.1.2
FLINK_IMAGE=flink:1.20.5-scala_2.12-java17
FLINK_KAFKA_CONNECTOR_VERSION=3.4.0-1.20
ICEBERG_FLINK_VERSION=1.11.0

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_RAW_TOPIC=environment.sensor-readings.raw
KAFKA_DLQ_TOPIC=environment.sensor-readings.dlq
KAFKA_LATE_TOPIC=environment.sensor-readings.late

FLINK_CHECKPOINT_URI=s3://environment-data/flink-checkpoints/
